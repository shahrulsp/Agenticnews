# Neon Postgres
NEON_DATABASE_URL=postgresql://neondb_owner:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
PUBLIC_DEFAULT_LOCALE="ms"
INTERNAL_INGEST_TOKEN="replace-with-a-long-random-bearer-token"
MISTRAL_API_KEY="replace-with-your-mistral-api-key"

# Admin auth
ADMIN_PASSWORD_HASH="\$2b\$10\$replace-with-bcrypt-hash"
ADMIN_COOKIE_SECRET="replace-with-a-long-random-secret"

# Internal draft ingest endpoint:
# POST /api/internal/drafts
# Authorization: Bearer $INTERNAL_INGEST_TOKEN
# Article agent_run_id can still store the Mistral workflow execution ID for traceability.
